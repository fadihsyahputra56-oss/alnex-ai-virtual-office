# ALNEX AI Virtual Office — contoh environment variables
# Salin file ini menjadi .env untuk jalan lokal, atau isi nilainya
# di Render Dashboard > Service > Environment.
# JANGAN menulis nilai asli di file ini dan JANGAN commit .env ke GitHub.
# Semua nilai di bawah ini hanya NAMA + contoh format, bukan nilai asli.

# Port server (Render mengisi PORT secara otomatis)
PORT=3000

# Koneksi database Supabase (PostgreSQL).
# Ambil dari Supabase Dashboard > Settings > Database > Connection string.
# Contoh format (ganti user, password, host, dan nama database):
DATABASE_URL=postgresql://postgres:PASSWORD_ANDA@db.PROYEK_ANDA.supabase.co:5432/postgres

# PIN login owner untuk melindungi endpoint /api/*
# Isi dengan PIN pilihan owner, contoh: 4-8 digit angka.
OWNER_PIN=

# Lynk.id — Merchant Key untuk validasi webhook.
# Ambil dari dashboard Lynk.id (Settings > Integrations / API).
# Bila kosong, webhook diterima tetapi dicatat "tanpa validasi secret".
LYNK_MERCHANT_KEY=

# WhatsApp Business Cloud API (Meta for Developers)
# Verify Token: token yang Anda buat sendiri untuk verifikasi webhook di Meta.
WHATSAPP_VERIFY_TOKEN=
# Access Token: token permanen dari aplikasi Meta Anda.
WHATSAPP_ACCESS_TOKEN=
# Phone Number ID: ID nomor WhatsApp Business Anda di Meta.
WHATSAPP_PHONE_NUMBER_ID=

# Opsional: kunci model AI eksternal (bila ingin agen memakai model AI).
# Bila kosong, agen tetap menjawab dari data tersimpan (rule-based).
OPENAI_API_KEY=
